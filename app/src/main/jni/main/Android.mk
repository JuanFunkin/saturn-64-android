SAT := ../saturn

include $(CLEAR_VARS)
LOCAL_MODULE := main

LOCAL_SHARED_LIBRARIES := SDL2

LOCAL_C_INCLUDES := \
    $(LOCAL_PATH)/compat \
    $(LOCAL_PATH)/$(SAT)/include \
    $(LOCAL_PATH)/$(SAT)/build/us_pc \
    $(LOCAL_PATH)/$(SAT)/build/us_pc/include \
    $(LOCAL_PATH)/$(SAT)/src \
    $(LOCAL_PATH)/$(SAT)

