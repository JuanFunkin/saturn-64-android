+#ifdef __ANDROID__
+    // On Android the ROM is chosen with the system file picker (ImportActivity), validated and copied to
+    // <data folder>/rom.z64 BEFORE this process starts. Nothing to prompt for here.
+    {
+        rom_path = std::string(android_data_dir) + "/rom.z64";
+        std::string err = "";
+        if (!std::filesystem::exists(rom_path)) err = "rom_missing";
+        else if (std::filesystem::file_size(rom_path) != ROM_SIZE) err = "rom_invalid";
+        else {
+            std::ifstream stream = std::ifstream(rom_path, std::ios::binary);
+            unsigned char* data = (unsigned char*)malloc(ROM_SIZE);
+            stream.read((char*)data, ROM_SIZE);
+            stream.close();
+            unsigned int checksum = crc32(data, ROM_SIZE);
+            free(data);
+            if (checksum != ROM_CHECKSUM) err = "rom_invalid";
+        }
+        if (err != "") {
+            // ImportActivity reads this file the next time it is opened and shows the message.
+            android_write_text_file("rom_error.txt", err.c_str());
+            android_set_status(-1, err.c_str());
+            exit(3);
+        }
+    }
+#else
     while (true) {
