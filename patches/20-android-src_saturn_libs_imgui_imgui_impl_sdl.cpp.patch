--- a/src/saturn/libs/imgui/imgui_impl_sdl.cpp
+++ b/src/saturn/libs/imgui/imgui_impl_sdl.cpp
@@ -418,8 +418,15 @@
     IM_DELETE(bd);
 }
 
+#ifdef __ANDROID__
+extern "C" float saturn_mobile_ui_scale(void);
+#endif
+
 static void ImGui_ImplSDL2_UpdateMouseData()
 {
+#ifdef __ANDROID__
+    return; // the mouse is driven by the touch gesture layer (saturn_mobile_ui.cpp), never by SDL
+#endif
     ImGui_ImplSDL2_Data* bd = ImGui_ImplSDL2_GetBackendData();
     ImGuiIO& io = ImGui::GetIO();
 
@@ -532,9 +539,20 @@
         SDL_GetRendererOutputSize(bd->Renderer, &display_w, &display_h);
     else
         SDL_GL_GetDrawableSize(bd->Window, &display_w, &display_h);
+#ifdef __ANDROID__
+    // Dear ImGui works in "logical" pixels = physical pixels / UI scale, so the desktop layout is readable and
+    // touchable on a phone. The framebuffer scale makes the renderer rasterize at full resolution.
+    {
+        const float S = saturn_mobile_ui_scale();
+        io.DisplaySize = ImVec2((float)w / S, (float)h / S);
+        if (w > 0 && h > 0)
+            io.DisplayFramebufferScale = ImVec2((float)display_w / ((float)w / S), (float)display_h / ((float)h / S));
+    }
+#else
     io.DisplaySize = ImVec2((float)w, (float)h);
     if (w > 0 && h > 0)
         io.DisplayFramebufferScale = ImVec2((float)display_w / w, (float)display_h / h);
+#endif
 
     // Setup time step (we don't use SDL_GetTicks() because it is using millisecond resolution)
     static Uint64 frequency = SDL_GetPerformanceFrequency();
