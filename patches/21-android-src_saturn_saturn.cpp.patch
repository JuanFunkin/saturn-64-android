+#ifdef __ANDROID__
+// Credit line drawn on the splash screen. There is no font library at this point, so the glyphs come from a
+// standalone Dear ImGui font atlas (built-in default font) copied into an SDL texture.
+#include "saturn/libs/imgui/imgui.h"
+static ImFontAtlas* credit_atlas = nullptr;
+static SDL_Texture* credit_tex = nullptr;
+static int credit_w = 0, credit_h = 0;
+
+static void splash_credit_init(SDL_Renderer* renderer) {
+    credit_atlas = new ImFontAtlas();
+    ImFontConfig cfg;
+    cfg.SizePixels = 13.0f;
+    credit_atlas->AddFontDefault(&cfg);
+    unsigned char* px = nullptr;
+    credit_atlas->GetTexDataAsAlpha8(&px, &credit_w, &credit_h);
+    if (!px) return;
+    SDL_Surface* surf = SDL_CreateRGBSurfaceWithFormat(0, credit_w, credit_h, 32, SDL_PIXELFORMAT_RGBA32);
+    if (!surf) return;
+    for (int y = 0; y < credit_h; y++) {
+        Uint8* row = (Uint8*)surf->pixels + y * surf->pitch;
+        for (int x = 0; x < credit_w; x++) {
+            row[x * 4 + 0] = 255; row[x * 4 + 1] = 255; row[x * 4 + 2] = 255;
+            row[x * 4 + 3] = px[y * credit_w + x];
+        }
+    }
+    credit_tex = SDL_CreateTextureFromSurface(renderer, surf);
+    SDL_FreeSurface(surf);
+    if (credit_tex) SDL_SetTextureBlendMode(credit_tex, SDL_BLENDMODE_BLEND);
+}
+
+static void splash_credit_draw(SDL_Renderer* renderer, const char* text, float center_x, float y, float scale) {
+    if (!credit_tex || !credit_atlas || credit_atlas->Fonts.Size == 0) return;
+    ImFont* font = credit_atlas->Fonts[0];
+    float width = 0;
+    for (const char* c = text; *c; c++) { const ImFontGlyph* g = font->FindGlyph((ImWchar)*c); if (g) width += g->AdvanceX * scale; }
+    float x = center_x - width / 2;
+    SDL_SetTextureColorMod(credit_tex, 255, 255, 255);
+    for (const char* c = text; *c; c++) {
+        const ImFontGlyph* g = font->FindGlyph((ImWchar)*c);
+        if (!g) continue;
+        if (g->Visible) {
+            SDL_Rect src = { (int)(g->U0 * credit_w + 0.5f), (int)(g->V0 * credit_h + 0.5f),
+                             (int)((g->U1 - g->U0) * credit_w + 0.5f), (int)((g->V1 - g->V0) * credit_h + 0.5f) };
+            SDL_Rect dst = { (int)(x + g->X0 * scale), (int)(y + g->Y0 * scale + 11 * scale),
+                             (int)((g->X1 - g->X0) * scale + 0.5f), (int)((g->Y1 - g->Y0) * scale + 0.5f) };
+            SDL_RenderCopy(renderer, credit_tex, &src, &dst);
+        }
+        x += g->AdvanceX * scale;
+    }
+}
+#endif
